/**
 * Deploys the site as its own Worker: the vinext server bundle plus the
 * client build as static assets. Requests that match an asset are served
 * directly; everything else renders through the worker, which is exactly
 * how the contract tests already drive this bundle.
 *
 * No account id lives here on purpose: `wrangler deploy` reads
 * CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID from the environment
 * (the repository's ignored .env), so this file stays safe to publish.
 *
 * Build first, from the repository root:
 *   npm run build --prefix site
 *   npx wrangler deploy --config site/wrangler.deploy.jsonc
 *
 * Named wrangler.deploy.jsonc, not wrangler.jsonc, on purpose: the Cloudflare
 * vite plugin auto-discovers a wrangler.jsonc and merges it into its own dev
 * config, which declared nodejs_compat twice and kept the dev server from
 * starting at all. Deploy config and dev config stay separate files.
 */
{
  "name": "baseclf-site",
  // One canonical address. Without this, dropping the routes block turns the
  // workers.dev route back on and the site answers at two hosts.
  "workers_dev": false,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "logs": { "enabled": true } },
  // baseclf.dev and www.baseclf.dev are attached as Workers custom domains,
  // done once by deploying with a `routes` block of custom_domain entries.
  // The block is deliberately absent now: with the domains already on the
  // zone, a redeploy that carries it makes wrangler list zone routes for
  // conflicts, and that zone-scoped read is a permission the deploy token
  // does not hold (Authentication error 10000, measured 2026-08-21). The
  // domains persist on the zone independently of this file.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
