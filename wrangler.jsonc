{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baseclf",
  "main": "src/index.ts",

  // Never omit this. Without it the API defaults to 2021-11-02, not today.
  "compatibility_date": "2026-07-28",

  // Required for node:crypto, which Better Auth needs for scrypt.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "logs": { "enabled": true }
  },

  // Placeholder ids. `npx create-baseclf` provisions the real resources into
  // the user's own Cloudflare account and rewrites these. Never commit real ids.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baseclf",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  "vars": {
    // The origin this Worker is served from. Getting it wrong is the most
    // common cause of redirect_uri_mismatch, so the engine refuses to start
    // rather than inferring one per request.
    "BETTER_AUTH_URL": "https://baseclf.example.workers.dev",

    // Comma separated origins allowed to call the auth endpoints. A frontend on
    // another origin must be listed here or its preflight fails.
    "BETTER_AUTH_TRUSTED_ORIGINS": "http://localhost:3000",

    // Off by default, and that is a measurement rather than a preference.
    // Hashing a password costs 58 ms of CPU against a free-plan budget of 10 ms
    // for the whole request, and the cost is inherent to the scrypt parameters.
    // OAuth performs no hash, so social login works on any plan. Set "true"
    // only on a paid plan.
    "BETTER_AUTH_EMAIL_PASSWORD": "false"
  }

  // BETTER_AUTH_SECRET is deliberately absent. It is a secret, so it goes in
  // with `wrangler secret put BETTER_AUTH_SECRET` and never into this file.
  // Without it the engine refuses every request rather than serving them all
  // anonymously, because a deployment missing its secret should be visibly
  // broken rather than quietly open.
}
