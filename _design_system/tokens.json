{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "BaseCLF design tokens. Source of truth, theme.css is generated from this file.",
  "$version": "0.2.0",
  "$changelog": "0.2.0, Removed the brass brand accent. Neutral moved warm→cool. The only saturated colours in the product are now the three semantic signals. See EXTERNAL-SKILLS.md §2 for the reasoning.",

  "color": {
    "neutral": {
      "$description": "Cool neutral, slight blue cast. Reads technical. Never pure #000 or #fff.",
      "$why-not-warm": "A warm paper/espresso neutral paired with a brass accent is a documented AI-design tell. See EXTERNAL-SKILLS.md §2.",
      "0":   "#FFFFFF",
      "25":  "#FBFBFC",
      "50":  "#F5F5F7",
      "100": "#EAEAEE",
      "200": "#DADAE1",
      "300": "#BCBCC6",
      "400": "#9797A3",
      "500": "#75757F",
      "600": "#52525B",
      "700": "#3B3B43",
      "800": "#27272C",
      "900": "#16161A",
      "950": "#0B0B0D"
    },

    "allow": {
      "$description": "SIGNAL. Row visible / operation permitted. Never decorative.",
      "50":  "#E9F6EE",
      "100": "#CDEBD9",
      "300": "#6FBF8E",
      "400": "#3F9E66",
      "500": "#157F4C",
      "600": "#0F6640",
      "900": "#0B241A"
    },

    "deny": {
      "$description": "SIGNAL. Blocked by policy. Never decorative.",
      "50":  "#FCECEB",
      "100": "#F8D5D2",
      "300": "#E89B95",
      "400": "#D9635C",
      "500": "#C0362C",
      "600": "#9E2820",
      "900": "#2C1412"
    },

    "attention": {
      "$description": "SIGNAL. Missing index, exposed table, config drift. ALSO the focus-ring colour, focus means 'look here', which is the same job.",
      "$why-this-amber": "High yellow, near-zero blue channel. Reads as a warning signal, not as a warm-craft brass tone.",
      "50":  "#FCF3D9",
      "100": "#F7E4AE",
      "300": "#E5BE4E",
      "400": "#D19E00",
      "500": "#9A6F00",
      "600": "#7D5A00",
      "900": "#2A2005"
    }
  },

  "semantic": {
    "$rule": "There is NO brand accent. The brand mark is ink. The only saturated colours in the interface are allow, deny and attention.",

    "light": {
      "canvas": "{color.neutral.25}",
      "surface": "{color.neutral.0}",
      "surface-raised": "{color.neutral.0}",
      "surface-sunken": "{color.neutral.50}",
      "surface-hover": "{color.neutral.50}",
      "surface-active": "{color.neutral.100}",

      "border-subtle": "{color.neutral.100}",
      "border": "{color.neutral.200}",
      "border-strong": "{color.neutral.300}",

      "text-primary": "{color.neutral.900}",
      "text-secondary": "{color.neutral.600}",
      "text-tertiary": "{color.neutral.500}",
      "text-disabled": "{color.neutral.400}",
      "text-inverse": "{color.neutral.25}",

      "focus-ring": "{color.attention.500}",

      "allow-text": "{color.allow.500}",
      "allow-tint": "{color.allow.50}",
      "allow-border": "{color.allow.300}",
      "deny-text": "{color.deny.500}",
      "deny-tint": "{color.deny.50}",
      "deny-border": "{color.deny.300}",
      "attention-text": "{color.attention.500}",
      "attention-tint": "{color.attention.50}",
      "attention-border": "{color.attention.300}"
    },

    "dark": {
      "canvas": "{color.neutral.950}",
      "surface": "#141417",
      "surface-raised": "#1A1A1F",
      "surface-sunken": "#08080A",
      "surface-hover": "#1D1D22",
      "surface-active": "#24242A",

      "border-subtle": "#232329",
      "border": "#2E2E36",
      "border-strong": "#43434E",

      "text-primary": "#F0F0F3",
      "text-secondary": "#A0A0AC",
      "text-tertiary": "#74747F",
      "text-disabled": "{color.neutral.600}",
      "text-inverse": "{color.neutral.900}",

      "focus-ring": "{color.attention.300}",

      "allow-text": "{color.allow.400}",
      "allow-tint": "{color.allow.900}",
      "allow-border": "{color.allow.600}",
      "deny-text": "{color.deny.400}",
      "deny-tint": "{color.deny.900}",
      "deny-border": "{color.deny.600}",
      "attention-text": "{color.attention.300}",
      "attention-tint": "{color.attention.900}",
      "attention-border": "{color.attention.600}"
    }
  },

  "font": {
    "family": {
      "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace",
      "$serif-note": "No serif in the system. Serif is discouraged as a default and banned in dashboards. If a docs page genuinely needs an editorial register, argue for it in the PR."
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "size": {
      "micro":   { "size": "0.6875rem", "line": "1rem",     "$use": "table meta, badge, timestamp" },
      "xs":      { "size": "0.75rem",   "line": "1.125rem", "$use": "caption, helper text" },
      "sm":      { "size": "0.8125rem", "line": "1.25rem",  "$use": "COMPACT body, Studio default" },
      "base":    { "size": "0.875rem",  "line": "1.375rem", "$use": "UI body" },
      "md":      { "size": "1rem",      "line": "1.625rem", "$use": "COMFORTABLE body, docs default" },
      "lg":      { "size": "1.125rem",  "line": "1.75rem",  "$use": "docs lede" },
      "h3":      { "size": "1.375rem",  "line": "1.875rem", "tracking": "-0.011em" },
      "h2":      { "size": "1.75rem",   "line": "2.25rem",  "tracking": "-0.014em" },
      "h1":      { "size": "2.25rem",   "line": "2.75rem",  "tracking": "-0.018em" },
      "display": { "size": "3rem",      "line": "3.375rem", "tracking": "-0.022em", "$use": "landing only, headline 3-5 words" }
    },
    "measure": { "prose": "34rem", "$comment": "~68 characters. Hard cap for reading columns." }
  },

  "icon": {
    "$rule": "One family per project. Never hand-roll SVG icon paths.",
    "library": "@phosphor-icons/react",
    "fallbacks": ["@radix-ui/react-icons", "@tabler/icons-react"],
    "discouraged": ["lucide-react"],
    "stroke-width": 1.5,
    "sizes": { "sm": "14px", "md": "16px", "lg": "20px" }
  },

  "space": {
    "$base": "4px",
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem",
    "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem",
    "10": "2.5rem", "12": "3rem", "16": "4rem", "24": "6rem"
  },

  "radius": {
    "none": "0", "xs": "2px", "sm": "3px", "md": "5px", "full": "999px",
    "$rule": "Documented mixed scale (permitted): inputs/badges 2px, buttons/panels 3px, dialogs 5px, avatars/pills full. Table cells 0. Nothing else."
  },

  "border": {
    "width": { "hairline": "1px", "emphasis": "2px" },
    "$rule": "Structure is built from 1px rules, not shadows."
  },

  "shadow": {
    "$rule": "Only two exist. Anything else uses a border.",
    "popover": {
      "light": "0 2px 8px -2px rgb(22 22 26 / 0.10), 0 4px 16px -4px rgb(22 22 26 / 0.08)",
      "dark": "0 2px 8px -2px rgb(0 0 0 / 0.50), 0 4px 16px -4px rgb(0 0 0 / 0.40), inset 0 1px 0 0 rgb(255 255 255 / 0.04)"
    },
    "dialog": {
      "light": "0 8px 24px -6px rgb(22 22 26 / 0.14), 0 16px 48px -12px rgb(22 22 26 / 0.10)",
      "dark": "0 8px 24px -6px rgb(0 0 0 / 0.60), 0 16px 48px -12px rgb(0 0 0 / 0.50), inset 0 1px 0 0 rgb(255 255 255 / 0.05)"
    }
  },

  "motion": {
    "duration": { "instant": "80ms", "fast": "140ms", "moderate": "200ms", "slow": "320ms", "reveal": "600ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "reveal": "cubic-bezier(0.16, 1, 0.3, 1)",
      "linear": "linear"
    },
    "$rule": "No spring. No bounce. No overshoot. `reveal` duration/easing are LANDING ONLY, never in Studio.",
    "stagger": { "step": "80ms", "$scope": "landing only, max 6 items" }
  },

  "density": {
    "compact":     { "scale": 0.8, "base-size": "sm", "row-height": "28px", "$use": "Studio, tables" },
    "comfortable": { "scale": 1.0, "base-size": "md", "row-height": "40px", "$use": "docs, landing" }
  },

  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" },

  "z": { "base": 0, "sticky": 10, "dropdown": 20, "popover": 30, "dialog": 40, "toast": 50 }
}
