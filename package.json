{
  "name": "create-baseclf",
  "version": "0.4.6",
  "description": "Auto-REST and real row-level security for Cloudflare D1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "cf-typegen": "wrangler types",
    "guard": "node scripts/guard-commit.mjs --all",
    "guard:release": "node scripts/guard-release.mjs",
    "deploy": "npm run guard:release -- deploy && wrangler deploy",
    "build:theme": "node scripts/build-theme.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:version": "node scripts/check-versions.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:design && npm run check:version && npm run build:cli && npm run check:package && npm run stage:sdk",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "mutate:jwks-source": "node scripts/mutate-jwks-source.mjs",
    "mutate:diagnose-cors": "node scripts/mutate-diagnose-cors.mjs",
    "mutate:storage-policy": "node scripts/mutate-storage-policy.mjs",
    "mutate:storage-router": "node scripts/mutate-storage-router.mjs",
    "mutate:storage-wiring": "node scripts/mutate-storage-wiring.mjs",
    "mutate:storage-objects": "node scripts/mutate-storage-objects.mjs",
    "mutate:storage-reconcile": "node scripts/mutate-storage-reconcile.mjs",
    "mutate:secret": "node scripts/mutate-secret.mjs",
    "mutate:bootstrap": "node scripts/mutate-bootstrap.mjs",
    "mutate:auth-bootstrap": "node scripts/mutate-auth-bootstrap.mjs",
    "mutate:create": "node scripts/mutate-create.mjs",
    "mutate:deploy": "node scripts/mutate-deploy.mjs",
    "mutate": "npm run mutate:jwks-source && npm run mutate:diagnose-cors && npm run mutate:storage-policy && npm run mutate:storage-router && npm run mutate:storage-wiring && npm run mutate:storage-objects && npm run mutate:storage-reconcile && npm run mutate:cli && npm run mutate:provision && npm run mutate:secret && npm run mutate:bootstrap && npm run mutate:auth-bootstrap && npm run mutate:create && npm run mutate:deploy && npm run mutate:wrangler-credential && npm run mutate:run-create && npm run mutate:login && npm run mutate:policy-cli && npm run mutate:registry-cache && npm run mutate:storage-ratelimit && npm run mutate:policy-lint && npm run mutate:policy-lock && npm run mutate:mcp-auth && npm run mutate:reserved-tables && npm run mutate:mcp-tools && npm run mutate:registry-isolation && npm run mutate:introspect-batch && npm run mutate:handover && npm run mutate:sdk",
    "demo:v1": "node scripts/demo-v1.mjs",
    "demo:v2": "node scripts/demo-v2.mjs",
    "build:cli": "npm run build && node scripts/build-cli.mjs",
    "mutate:cli": "node scripts/mutate-cli.mjs",
    "mutate:provision": "node scripts/mutate-provision.mjs",
    "mutate:wrangler-credential": "node scripts/mutate-wrangler-credential.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build:cli",
    "prepublishOnly": "npm run guard:release -- publish && npm run guard && npm run check",
    "mutate:run-create": "node scripts/mutate-run-create.mjs",
    "mutate:login": "node scripts/mutate-login.mjs",
    "stage:alias": "node scripts/stage-alias-package.mjs",
    "stage:sdk": "node scripts/stage-sdk-package.mjs",
    "mutate:policy-cli": "node scripts/mutate-policy-cli.mjs",
    "mutate:introspect-batch": "node scripts/mutate-introspect-batch.mjs",
    "mutate:sdk": "node scripts/mutate-sdk.mjs",
    "mutate:registry-cache": "node scripts/mutate-registry-cache.mjs",
    "mutate:storage-ratelimit": "node scripts/mutate-storage-ratelimit.mjs",
    "mutate:policy-lint": "node scripts/mutate-policy-lint.mjs",
    "mutate:policy-lock": "node scripts/mutate-policy-lock.mjs",
    "mutate:mcp-auth": "node scripts/mutate-mcp-auth.mjs",
    "mutate:reserved-tables": "node scripts/mutate-reserved-tables.mjs",
    "mutate:mcp-tools": "node scripts/mutate-mcp-tools.mjs",
    "mutate:registry-isolation": "node scripts/mutate-registry-isolation.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "mutate:handover": "node scripts/mutate-handover.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "better-auth": "1.6.26",
    "jose": "6.2.8",
    "kysely": "0.29.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  },
  "bin": {
    "create-baseclf": "dist-cli/create-baseclf.mjs",
    "baseclf": "dist-cli/baseclf.mjs"
  },
  "files": [
    "dist-cli/create-baseclf.mjs",
    "dist-cli/baseclf.mjs",
    "dist-cli/worker.js",
    "LICENSING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baseclf/baseclf.git"
  },
  "homepage": "https://github.com/baseclf/baseclf",
  "bugs": {
    "url": "https://github.com/baseclf/baseclf/issues"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "workers",
    "row-level-security",
    "rls",
    "postgrest",
    "supabase",
    "baas",
    "r2",
    "policy"
  ]
}
